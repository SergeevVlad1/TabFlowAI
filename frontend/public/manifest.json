{
	"manifest_version": 3,
	"name": "TabFlowAI",
	"version": "1.0.0",
	"description": "Organize tabs, manage tasks, and boost productivity with smart tab grouping and workflow tools.",
	"key": "",
	"icons": {
		"16": "icons/TabFlow_16x16.png",
		"48": "icons/TabFlow_48x48.png",
		"128": "icons/TabFlow_128x128.png"
	},
	"permissions": [
		"tabs",
		"tabGroups",
		"storage",
		"alarms",
		"activeTab",
		"sidePanel"
	],
	"action": {
		"default_title": "Open Dashboard"
	},
	"side_panel": {
		"default_path": "index.html"
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"host_permissions": ["<all_urls>"]
}
