{
  "manifest_version": 3,
  "name": "Productivity AI Agent",
  "version": "1.0.0",
  "description": "Smart productivity extension with Task Manager, Tab Control, and AI Insights",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "activeTab"
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Open Dashboard"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": [
    "<all_urls>"
  ]
}